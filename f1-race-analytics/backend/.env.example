# Copy this file to backend/.env and fill in real values there.
#   cp backend/.env.example backend/.env
# backend/.env is gitignored — never commit real keys.
#
# All values below are placeholders. The app needs an Azure AI Foundry (or
# Azure OpenAI) resource with a chat model and an embedding model deployed.
# Charts and the race selector work without any of this; the summary, chat,
# and knowledge-base features do not.

# --- Required: Azure OpenAI chat + embeddings ---

# Your resource root, NOT the /api/projects/<name> project path shown in the
# Foundry portal's URL bar. Format: https://<resource-name>.openai.azure.com
# or https://<resource-name>.services.ai.azure.com — see backend/llm/client.py
# for why the resource root and not the project path.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com

# Portal: Foundry project > Overview, or the resource's "Keys and Endpoint" page.
AZURE_OPENAI_API_KEY=your-api-key-here

# The *deployment name* you gave your chat model (not the base model id).
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name

# Any version your resource supports. 2024-10-21 is a safe default.
AZURE_OPENAI_API_VERSION=2024-10-21

# The deployment name of your embedding model — used by the RAG knowledge
# base (backend/rag/embeddings.py) to embed knowledge_base/*.md and user
# queries. Falls back to "text-embedding-3-small" if unset.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name

# --- Optional: Foundry evaluation upload ---

# Only used by `python -m evals.run_evaluation --push-to-foundry`, to upload
# eval results to the Foundry portal's Evaluation tab. This IS the
# /api/projects/<name> project path (unlike AZURE_OPENAI_ENDPOINT above), found
# on the Foundry project's Overview page. Needs `az login` run once on this
# machine (separate, Entra-ID auth — the API key above doesn't cover it).
# Leave unset and --push-to-foundry just skips the upload.
AZURE_AI_PROJECT_ENDPOINT=https://your-resource-name.services.ai.azure.com/api/projects/your-project-name
