# Copy this file to backend/.env and fill in real values there.
# backend/.env is gitignored — never commit real keys.

# Resource root only (NOT the /api/projects/<name> project path from the
# Foundry portal) — see backend/llm/client.py for why.
AZURE_OPENAI_ENDPOINT=https://f1-project-foundry.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Same endpoint/key as above, different deployment — used by the RAG
# knowledge base (backend/rag/embeddings.py) to embed knowledge_base/*.md
# and user queries. Defaults to this value even if unset.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# THIS one IS the /api/projects/<name> project path (unlike
# AZURE_OPENAI_ENDPOINT above) — found on your Foundry project's Overview
# page. Only used by evals/run_evaluation.py --push-to-foundry, to upload
# eval results to the Foundry portal's evaluation tab. Needs `az login` run
# once on this machine first (separate, AAD-based auth — the API key above
# doesn't cover this). Optional: leave unset and --push-to-foundry just
# skips the upload.
AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
