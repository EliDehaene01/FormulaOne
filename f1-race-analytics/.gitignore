# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Secrets — never commit real keys (see backend/.env.example)
.env

# Generated data & artifacts under backend/storage/ — all regenerated by the
# pipeline (ingest.py, rag/build_index.py, models/train.py). The trained model
# checkpoint is the one thing we keep so the app runs on a fresh clone.
backend/storage/*
!backend/storage/qualifying_model.pt

# MLflow tracking (also written under backend/storage/, but ignore anywhere)
mlruns/

# Local eval output (regenerate with: python -m evals.run_evaluation)
evals/last_run_results.json

# Frontend
node_modules/
dist/

# Tooling caches / editor / OS
.impeccable/
.claude/
.DS_Store
